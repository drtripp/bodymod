{
  "appId": "app.bodymod.local",
  "appName": "bodymod",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#f3efe6"
    },
    "SplashScreen": {
      "launchShowDuration": 350,
      "launchAutoHide": true,
      "launchFadeOutDuration": 160,
      "backgroundColor": "#f3efe6",
      "showSpinner": false
    }
  }
}
