{
  "version": 1,
  "datasetId": "ansur-ii-candidate-import-v1",
  "label": "ANSUR II candidate anthropometry import",
  "reference": "ANSUR II candidate import; source/license review required before production use",
  "source": "ANSUR II raw anthropometry CSV, not bundled in this repository.",
  "sourceUrl": "",
  "includedPopulation": "U.S. Army personnel represented in the provided ANSUR II source CSV.",
